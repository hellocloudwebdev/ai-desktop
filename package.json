{
  "name": "ai-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && vitest run",
    "architecture:check": "node scripts/validate-dependencies.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.6",
    "prisma": "6.4.1",
    "@types/node": "^24.13.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.1.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@prisma/client": "6.4.1"
  }
}
