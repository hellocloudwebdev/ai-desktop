{
  "name": "@ai-desktop/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:win": "pnpm dist --win",
    "dist:mac": "pnpm dist --mac",
    "dist:linux": "pnpm dist --linux",
    "release:artifacts": "node ../../scripts/release/artifact-validation.mjs",
    "release:checksums": "node ../../scripts/release/checksums.mjs",
    "release:manifest": "node ../../scripts/release/release-manifest.mjs"
  },
  "dependencies": {
    "@ai-desktop/agent-runtime": "workspace:*",
    "@ai-desktop/ai-core": "workspace:*",
    "@ai-desktop/execution": "workspace:*",
    "@ai-desktop/mcp": "workspace:*",
    "@ai-desktop/memory": "workspace:*",
    "@ai-desktop/permissions": "workspace:*",
    "@ai-desktop/plugins": "workspace:*",
    "@ai-desktop/providers": "workspace:*",
    "@ai-desktop/shared": "workspace:*",
    "@ai-desktop/skills": "workspace:*",
    "@ai-desktop/storage": "workspace:*",
    "electron-updater": "6.8.9",
    "puppeteer-core": "25.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.1.0",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "4.1.11"
  }
}
