// Prisma Schema for ai-desktop
//
// Canonical storage rules (Step 31):
//   - Database: SQLite with WAL mode (PRAGMA journal_mode = WAL)
//   - Canonical Event model is append-only and immutable
//   - UNIQUE(conversationId, sequence) ensures strict ordering per conversation
//   - schemaVersion is persisted alongside every event
//   - Prisma Client is used exclusively within packages/storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id
  conversationId String
  taskId         String?
  sequence       Int
  schemaVersion  Int
  type           String
  payload        String   // JSON-serialized canonical event payload
  createdAt      String   // ISO-8601 UTC timestamp string

  @@unique([conversationId, sequence], name: "conversationId_sequence")
  @@index([conversationId])
  @@index([taskId])
  @@map("events")
}

// PR22: Provider profile persistence
// Stores user-configured provider instances. Raw credentials are never stored;
// only credentialRef (a reference into the OS SecretStore) is persisted.
model ProviderProfileRecord {
  id             String   @id          // ULID
  providerId     String                // canonical ProviderId (e.g. "anthropic", "gemini")
  name           String                // user-facing display name
  credentialRef  String?               // non-secret reference into OS keychain
  endpointUrl    String?               // optional custom endpoint
  organizationId String?               // optional org/workspace
  defaultModelId String?               // canonical ModelId (e.g. "gemini:gemini-2.5-flash")
  enabled        Boolean  @default(true)
  createdAt      BigInt                // epoch milliseconds
  updatedAt      BigInt                // epoch milliseconds

  @@index([providerId])
  @@map("provider_profiles")
}

// PR22: Conversation model selection persistence
// Records which provider/model a conversation uses, decoupled from global defaults
// so historical conversations retain their original model even if defaults change.
model ConversationModelRecord {
  conversationId String   @id          // canonical ConversationId
  providerId     String                // canonical ProviderId
  modelId        String                // canonical ModelId
  profileId      String?               // optional ProviderProfile ULID
  updatedAt      BigInt                // epoch milliseconds

  @@index([providerId])
  @@map("conversation_models")
}

// PR24: Permission policy persistence
// Stores durable project-scoped and persistent permission rules.
// Sensitive secrets are never stored in policy or resource definitions.
model PermissionPolicyRecord {
  id              String   @id          // ULID
  projectId       String?               // optional project scope
  capability      String                // e.g. "filesystem", "execution", "mcp", "secrets.use", "secrets.read"
  action          String?               // e.g. "read", "write", "execute", null for any
  resourcePattern String?               // path prefix, command prefix, tool name, secret ref
  decision        String                // "allow" | "deny"
  scope           String                // "project" | "session" | "once"
  createdAt       BigInt                // epoch milliseconds
  updatedAt       BigInt                // epoch milliseconds
  expiresAt       BigInt?               // optional epoch milliseconds

  @@index([projectId])
  @@index([capability])
  @@map("permission_policies")
}

// PR24: Append-only immutable permission audit history
// Records every actual permission decision without recording raw secrets or API keys.
model PermissionAuditRecord {
  id                  String   @id      // ULID
  projectId           String?           // optional project scope
  conversationId      String?           // optional conversation reference
  permissionRequestId String?           // optional permission request ULID
  capability          String            // evaluation dimension 1
  action              String            // evaluation dimension 2
  resource            String            // evaluation dimension 3
  scope               String            // evaluation dimension 4
  risk                String            // evaluation dimension 5
  decision            String            // "allow" | "deny" | "requires_user"
  decidedBy           String            // "user" | "policy" | "auto"
  relatedToolCallIds  String            // JSON array of ToolCallId strings
  reason              String?           // optional human or policy explanation
  timestamp           BigInt            // epoch milliseconds

  @@index([projectId])
  @@index([capability])
  @@index([timestamp])
  @@map("permission_audit")
}

// PR26: Installed Skill package metadata persistence
// Stores install location, metadata, and enabled status.
// Full package files remain on the local filesystem.
model SkillRecord {
  id          String   @id          // canonical SkillId (e.g. "code-review", "git-helper")
  name        String                // user-facing display name
  version     String                // SemVer (e.g. "1.0.0")
  description String
  source      String                // e.g. "local"
  installPath String                // absolute local filesystem path
  checksum    String                // package/manifest checksum
  installedAt BigInt                // epoch milliseconds
  updatedAt   BigInt                // epoch milliseconds
  enabled     Boolean  @default(false)
  projectId   String?               // optional project-specific enablement

  @@index([projectId])
  @@map("skills")
}

// PR28: Durable scoped memory facts persistence
// Stores facts extracted from conversations with global/project scope isolation.
// Raw credentials are never stored; superseded facts are kept for history, not retrieval.
model MemoryFactRecord {
  id                   String   @id      // canonical MemoryFactId (ULID)
  scopeLevel           String             // "global" | "project"
  projectId            String?            // required when scopeLevel = "project", null when global
  content              String             // fact text (max 2000 chars, no raw credentials)
  category             String             // "preference" | "fact" | "instruction" | "project_context" | "workflow"
  sensitivity          String   @default("normal") // "normal" | "sensitive"
  sourceConversationId String?            // optional conversation reference
  confidence           Float    @default(1.0)      // 0.0 to 1.0
  createdAt            BigInt             // epoch milliseconds
  updatedAt            BigInt             // epoch milliseconds
  supersededBy         String?            // MemoryFactId of replacing fact

  @@index([scopeLevel])
  @@index([projectId])
  @@index([updatedAt])
  @@index([supersededBy])
  @@map("memory_facts")
}
